# What the build needs from Homebrew (CI: brew bundle install --file Brewfile).
# bash 4.4 or newer: build.sh, run.sh and the scripts; pkgconf, cmake and ninja: the build;
# glslang and nasm: the host shaders and FFmpeg's assembly; spirv-tools and clang-format: DXC and
# the FSR 4.1.1 assets (without them the build leaves FSR 4.1.1 out).
brew "bash"
brew "pkgconf"
brew "cmake"
brew "ninja"
brew "glslang"
brew "nasm"
brew "spirv-tools"
brew "clang-format"
